{
  "version": 2,
  "builds": [
    {
      "src": "api.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/preview",
      "dest": "api.py"
    },
    {
      "src": "/predict",
      "dest": "api.py"
    },
    {
      "src": "/save-training-mask",
      "dest": "api.py"
    },
    {
      "src": "/download-mask/(.*)",
      "dest": "api.py"
    },
    {
      "src": "/training-data/(.*)",
      "dest": "api.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
